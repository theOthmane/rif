[
  {
    "name": "theme_info",
    "theme_name": "Skeleton",
    "theme_version": "0.1.0",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "RIFANO",
    "settings": [
      {
        "type": "text",
        "id": "announcement_text",
        "label": "t:labels.announcement_text",
        "default": "Paiement à la livraison · Livraison gratuite partout au Maroc"
      },
      {
        "type": "text",
        "id": "whatsapp_number",
        "label": "t:labels.whatsapp_number",
        "default": "212600000000"
      },
      {
        "type": "url",
        "id": "instagram_url",
        "label": "t:labels.instagram_url"
      },
      {
        "type": "url",
        "id": "tiktok_url",
        "label": "t:labels.tiktok_url"
      },
      {
        "type": "text",
        "id": "support_email",
        "label": "t:labels.support_email",
        "default": "contact@rifano.ma"
      },
      {
        "type": "text",
        "id": "delivery_text",
        "label": "t:labels.delivery_text",
        "default": "Livraison 24–72h"
      },
      {
        "type": "text",
        "id": "warranty_text",
        "label": "t:labels.warranty_text",
        "default": "Garantie 12 mois"
      },
      {
        "type": "text",
        "id": "returns_text",
        "label": "t:labels.returns_text",
        "default": "Retours sous 7 jours"
      },
      {
        "type": "link_list",
        "id": "home_rows_menu",
        "label": "t:labels.home_rows_menu"
      },
      {
        "type": "range",
        "id": "rows_visible",
        "label": "t:labels.rows_visible",
        "min": 1,
        "max": 6,
        "step": 1,
        "default": 3
      },
      {
        "type": "image_picker",
        "id": "hero_poster",
        "label": "Hero poster"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  }
]
