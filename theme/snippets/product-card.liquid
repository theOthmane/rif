{% doc %}
  The RIFANO product card: one link wrapping the media and the info (badge,
  title, price). With no product it renders a placeholder card instead.

  Loads `product-card.css` itself, so a card is styled wherever it is used
  without the layout having to know about it.

  @param {object} [product] - The product to render. When nil the card renders in placeholder mode.
  @param {number} [placeholder_index] - Which Shopify placeholder illustration to draw in placeholder mode (1-6)
  @param {string} [sizes] - The `sizes` attribute for the image srcset. Defaults to a generic 2/3/4 column grid.
  @param {string} [loading] - `'lazy'` (default), or `'eager'` for the first row of a grid

  @example
  {% render 'product-card', product: product, sizes: '(min-width: 768px) 30vw, 46vw' %}
  {% render 'product-card', product: product, loading: 'eager' %}
  {% render 'product-card', placeholder_index: 1 %}
{% enddoc %}

{{ 'product-card.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign loading = loading | default: 'lazy'
  assign sizes = sizes | default: '(min-width: 1200px) 25vw, (min-width: 768px) 33vw, 50vw'
  assign placeholder_index = placeholder_index | default: 1
  assign card_widths = '360, 540, 720, 960'
  assign badge = ''

  if product
    assign card_tag = 'a'
    assign media = product.featured_image
    assign second_media = product.images[1]

    if product.available == false
      assign badge = 'rifano.sold_out' | t
    elsif product.compare_at_price > product.price
      assign percent_off = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round
      assign badge = 'rifano.percent_off' | t: percent: percent_off
    endif
  else
    assign card_tag = 'div'
  endif
-%}

<article class="card">
  <{{ card_tag }} class="card__link"{% if product %} href="{{ product.url }}" aria-label="{{ product.title | escape }}"{% endif %}>
    {%- comment -%}
      `media` is only assigned when there is a product, so a product without a
      photo falls back to the placeholder illustration. Both images are
      decorative: the link already carries the product title as its accessible
      name, so an alt would only duplicate it.
    {% endcomment %}
    <div
      class="card__media{% if second_media %} card__media--swap{% endif %}"
      {% unless product %}aria-hidden="true"{% endunless %}
    >
      {%- if media -%}
        {{ media | image_url: width: 960 | image_tag: widths: card_widths, sizes: sizes, loading: loading, alt: '', class: 'card__image card__image--base' }}
        {%- if second_media -%}
          {{ second_media | image_url: width: 960 | image_tag: widths: card_widths, sizes: sizes, loading: loading, alt: '', class: 'card__image card__image--alt' }}
        {%- endif -%}
      {%- else -%}
        {{ 'product-' | append: placeholder_index | placeholder_svg_tag: 'card__placeholder' }}
      {%- endif -%}
    </div>

    <div class="card__info">
      {%- if badge != blank -%}
        <p class="card__badges">
          <span class="card__badge t-label">{{ badge }}</span>
        </p>
      {%- endif -%}

      {%- if product -%}
        <h3 class="card__title">{{ product.title }}</h3>
        {% render 'price', product: product %}
      {%- else -%}
        <h3 class="card__title">{{ 'rifano.product_coming_soon' | t }}</h3>
      {%- endif -%}
    </div>
  </{{ card_tag }}>
</article>
