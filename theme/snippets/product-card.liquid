{% doc %}
  The RIFANO product card: one link wrapping the media and the info (badge,
  title, price). With no product it renders a placeholder card instead.

  The calling section loads `product-card.css` and `product-card.js` once;
  loading them here emitted one tag pair per card.

  @param {object} [product] - The product to render. When nil the card renders in placeholder mode.
  @param {number} [placeholder_index] - Which Shopify placeholder illustration to draw in placeholder mode (1-6)
  @param {string} [sizes] - The `sizes` attribute for the image srcset. Defaults to a generic 2/3/4 column grid.
  @param {number} [heading_level] - Heading level of the card title (2-6). Defaults to 3.
  @param {string} [loading] - `'lazy'` (default), or `'eager'` for the first row of a grid

  @example
  {% render 'product-card', product: product, sizes: '(min-width: 768px) 30vw, 46vw' %}
  {% render 'product-card', product: product, loading: 'eager' %}
  {% render 'product-card', placeholder_index: 1 %}
{% enddoc %}


{%- liquid
  assign loading = loading | default: 'lazy'
  # An eager card is in the first row, where the collection LCP lives.
  assign fetchpriority = 'auto'
  if loading == 'eager'
    assign fetchpriority = 'high'
  endif
  assign heading_level = heading_level | default: 3
  assign sizes = sizes | default: '(min-width: 1200px) 25vw, (min-width: 768px) 33vw, 50vw'
  assign placeholder_index = placeholder_index | default: 1
  assign card_widths = '360, 540, 720, 960'
  assign badge = ''

  if product
    assign card_tag = 'a'
    assign media = product.featured_image
    assign second_media = product.images[1]

    # `product.price` and `product.compare_at_price` are each the minimum over
    # ALL variants, so comparing them can pair the cheapest variant with
    # another variant's compare-at and print a discount that does not exist.
    # Read both from one variant instead.
    assign card_variant = product.selected_or_first_available_variant

    if product.available == false
      assign badge = 'rifano.sold_out' | t
    elsif card_variant.compare_at_price > card_variant.price
      assign percent_off = card_variant.compare_at_price | minus: card_variant.price | times: 100.0 | divided_by: card_variant.compare_at_price | round
      assign badge = 'rifano.percent_off' | t: percent: percent_off
    endif

    # The hover-swap image ships as `data-src`/`data-srcset` and carries no
    # `src`, so a touch device never requests it: the crossfade behind
    # `(hover: hover) and (pointer: fine)` can never run there.
    # product-card.js promotes these attributes only on a hover-capable pointer.
    if second_media
      assign card_widths_list = card_widths | split: ', '
      assign second_srcset = ''
      for candidate_width in card_widths_list
        assign candidate_width = candidate_width | plus: 0
        assign candidate_url = second_media | image_url: width: candidate_width
        assign candidate = candidate_width | append: 'w ' | append: candidate_url
        if second_srcset == blank
          assign second_srcset = candidate
        else
          assign second_srcset = second_srcset | append: ', ' | append: candidate
        endif
      endfor
    endif
  else
    assign card_tag = 'div'
  endif
-%}

<article class="card" data-depth-tilt>
  <{{ card_tag }} class="card__link"{% if product %} href="{{ product.url }}"{% endif %}>
    {%- comment -%}
      `media` is only assigned when there is a product, so a product without a
      photo falls back to the placeholder illustration. Both images are
      decorative: the link takes its accessible name from the text inside it
      (badge, title, price), so an alt would only duplicate the title.
    {% endcomment %}
    <div
      class="card__media{% if second_media %} card__media--swap{% endif %}"
      {% unless product %}aria-hidden="true"{% endunless %}
    >
      {%- if media -%}
        {{ media | image_url: width: 960 | image_tag: widths: card_widths, sizes: sizes, loading: loading, fetchpriority: fetchpriority, alt: '', class: 'card__image card__image--base' }}
        {%- if second_srcset != blank -%}
          <img
            class="card__image card__image--alt"
            data-src="{{ second_media | image_url: width: 960 }}"
            data-srcset="{{ second_srcset }}"
            data-sizes="{{ sizes }}"
            alt=""
            width="{{ second_media.width }}"
            height="{{ second_media.height }}"
            aria-hidden="true"
          >
        {%- endif -%}
      {%- else -%}
        {{ 'product-' | append: placeholder_index | placeholder_svg_tag: 'card__placeholder' }}
      {%- endif -%}
    </div>

    <div class="card__info">
      {%- if badge != blank -%}
        <p class="card__badges">
          <span class="card__badge t-label">{{ badge }}</span>
        </p>
      {%- endif -%}

      {%- if product -%}
        <h{{ heading_level }} class="card__title">{{ product.title }}</h{{ heading_level }}>
        {% render 'price', variant: card_variant %}
      {%- else -%}
        <h{{ heading_level }} class="card__title">{{ 'rifano.product_coming_soon' | t }}</h{{ heading_level }}>
      {%- endif -%}
    </div>
  </{{ card_tag }}>
</article>
