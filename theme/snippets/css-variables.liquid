{% style %}
  /* Display: Tenor Sans — one weight (400), no italic, so `font-synthesis: none`
     on every rule that uses --font-display (base.css) keeps faux bold away.
     Body: Hanken Grotesk — one variable file, the whole 100–900 range. */
  @font-face {
    font-family: 'Tenor Sans';
    src: url("{{ 'tenor-sans-400.woff2' | asset_url }}") format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Hanken Grotesk';
    src: url("{{ 'hanken-grotesk-var.woff2' | asset_url }}") format('woff2');
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }

  :root {
    {% if settings.max_page_width != blank %}
      --page-max: {{ settings.max_page_width }};
    {% endif %}
    {% if settings.min_page_margin != blank %}
      --gutter: max({{ settings.min_page_margin }}px, clamp(1rem, 0.6rem + 1.6vw, 2rem));
    {% endif %}
  }
{% endstyle %}
