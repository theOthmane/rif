{% style %}
  @font-face {
    font-family: 'Bodoni Moda';
    src: url("{{ 'bodoni-moda-var.woff2' | asset_url }}") format('woff2');
    font-weight: 400 900;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Bodoni Moda';
    src: url("{{ 'bodoni-moda-italic-var.woff2' | asset_url }}") format('woff2');
    font-weight: 400 900;
    font-style: italic;
    font-display: swap;
  }
  @font-face {
    font-family: 'Manrope';
    src: url("{{ 'manrope-var.woff2' | asset_url }}") format('woff2');
    font-weight: 200 800;
    font-style: normal;
    font-display: swap;
  }

  :root {
    {% if settings.max_page_width != blank %}
      --page-max: {{ settings.max_page_width }};
    {% endif %}
    {% if settings.min_page_margin != blank %}
      --gutter: {{ settings.min_page_margin }}px;
    {% endif %}
  }
{% endstyle %}
