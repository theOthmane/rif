<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {{ 'hanken-grotesk-var.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {{ 'tenor-sans-400.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}

    {% # Load and preload the critical CSS %}
    {{ 'tokens.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'header.css' | asset_url | stylesheet_tag }}
    {{ 'footer.css' | asset_url | stylesheet_tag }}
    {%- comment -%}
      Spec 12 deviation (owner-approved): policy pages render through this
      layout with no template of their own, so the system styles reach them
      only from here — and only on policy pages.
    {%- endcomment -%}
    {%- if request.page_type == 'policy' -%}
      {{ 'system.css' | asset_url | stylesheet_tag }}
    {%- endif -%}

    {% # Inlined CSS Variables. Must render after tokens.css so the merchant overrides of --page-max / --gutter win the cascade. %}
    {% render 'css-variables' %}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body>
    <a href="#main-content" class="skip-link">{{ 'rifano.skip_to_content' | t }}</a>

    {% comment %}
      `.page` spans the whole document, so `.site-chrome` — which is sticky —
      has a page-spanning containing block. The sentinel deliberately sits
      outside `.site-chrome` so it still scrolls away (menu-drawer.js toggles
      `.is-scrolled` from its IntersectionObserver).
    {% endcomment %}
    <div class="page">
      <div class="header__sentinel" aria-hidden="true"></div>

      <div class="site-chrome">
        <menu-drawer>
          {% sections 'header-group' %}
        </menu-drawer>
      </div>

      <main id="main-content">
        {{ content_for_layout }}
      </main>

      {% sections 'footer-group' %}

      {%- comment -%}
        Static render so the drawer keeps the stable section id `cart-drawer`
        (spec 10): that id is what the Cart API's bundled section rendering
        asks for. Page mode ships no drawer — the header link and the product
        form then behave natively.
      {%- endcomment -%}
      {%- if settings.cart_type == 'drawer' -%}
        {% section 'cart-drawer' %}
      {%- endif -%}
    </div>
  </body>
</html>
