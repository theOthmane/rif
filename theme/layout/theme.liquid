<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {{ 'manrope-var.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {{ 'bodoni-moda-var.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}

    {% # Load and preload the critical CSS %}
    {{ 'tokens.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'header.css' | asset_url | stylesheet_tag }}

    {% # Inlined CSS Variables. Must render after tokens.css so the merchant overrides of --page-max / --gutter win the cascade. %}
    {% render 'css-variables' %}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body>
    <a href="#main-content" class="skip-link">{{ 'rifano.skip_to_content' | t }}</a>

    {% comment %}
      `.page` spans the whole document, so `.site-chrome` — which is sticky —
      has a page-spanning containing block. The sentinel deliberately sits
      outside `.site-chrome` so it still scrolls away (menu-drawer.js toggles
      `.is-scrolled` from its IntersectionObserver).
    {% endcomment %}
    <div class="page">
      <div class="header__sentinel" aria-hidden="true"></div>

      <div class="site-chrome">
        <menu-drawer>
          {% sections 'header-group' %}
        </menu-drawer>
      </div>

      <main id="main-content">
        {{ content_for_layout }}
      </main>

      {% sections 'footer-group' %}
    </div>
  </body>
</html>
