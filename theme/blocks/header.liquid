{% doc %}
  RIFANO site header: menu button left, RF monogram centre, cart right.
  Sticky with a scroll hairline. Self-contained: callers must leave the body empty.
{% enddoc %}

<header class="site-header" {{ block.shopify_attributes }}>
  <div class="site-header__inner">
    <div class="site-header__left">
      <button
        type="button"
        id="menu-button"
        class="icon-button header__menu-button"
        aria-controls="menu-drawer"
        aria-expanded="false"
      >
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <span class="visually-hidden">{{ 'rifano.menu' | t }}</span>
      </button>
    </div>

    <div class="site-header__logo">
      {% # TODO spec-02: replace with {% render 'logo', variant: 'monogram' %} once snippets/logo.liquid lands. %}
      <a href="{{ routes.root_url }}" class="header__logo" aria-label="{{ shop.name }}">
        <span class="header__monogram" aria-hidden="true">RF</span>
      </a>
    </div>

    <div class="site-header__right">
      <a
        href="{{ routes.cart_url }}"
        class="icon-button header__cart"
        aria-label="{{ 'rifano.cart_with_count' | t: count: cart.item_count }}"
      >
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <path d="M6 8h12l1 12H5L6 8z" />
          <path d="M9 8V6a3 3 0 0 1 6 0v2" />
        </svg>
        {%- comment -%}
          {% partial %} only renders when the Liquid '26 feature preview is on
          (shop.features.agentic_editor_enabled?); otherwise the storefront raises
          "Unknown tag 'partial'". Fall back to plain markup so the header never
          breaks the site. See theme/AGENTS.md "The partial tag".
        {%- endcomment -%}
        {%- if shop.features.agentic_editor_enabled? -%}
          {% partial 'cart-count' %}
            <span id="cart-icon-bubble" class="cart-count" {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
          {% endpartial %}
        {%- else -%}
          <span id="cart-icon-bubble" class="cart-count" {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
        {%- endif -%}
      </a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}
