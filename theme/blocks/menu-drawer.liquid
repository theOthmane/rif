{% doc %}
  Full-height menu drawer: search, navigation, contact. Opened with showModal().
  Wired by <menu-drawer> in menu-drawer.js. Self-contained: callers must leave the body empty.
{% enddoc %}

<dialog
  id="menu-drawer"
  class="menu-drawer"
  aria-label="{{ 'rifano.menu' | t }}"
  scroll-lock
  {{ block.shopify_attributes }}
>
  <div class="menu-drawer__panel">
    <div class="menu-drawer__top">
      <button
        type="button"
        class="icon-button menu-drawer__close"
        data-menu-close
        aria-label="{{ 'rifano.close' | t }}"
      >
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
        <span class="visually-hidden">{{ 'rifano.close' | t }}</span>
      </button>
      <p class="menu-drawer__welcome t-label">{{ 'rifano.welcome' | t }}</p>
    </div>

    <form action="{{ routes.search_url }}" method="get" role="search" class="menu-drawer__search">
      <label class="visually-hidden" for="menu-drawer-search">{{ 'rifano.search_label' | t }}</label>
      <input
        id="menu-drawer-search"
        type="search"
        name="q"
        placeholder="{{ 'rifano.search_placeholder' | t }}"
        autocomplete="off"
      >
      <input type="hidden" name="type" value="product">
      <button type="submit" class="icon-button menu-drawer__search-button" aria-label="{{ 'rifano.search_label' | t }}">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <circle cx="11" cy="11" r="7" />
          <path d="M16.5 16.5L21 21" />
        </svg>
      </button>
    </form>

    {% liquid
      assign nav_menu = block.settings.menu
      if nav_menu == blank
        assign nav_menu = linklists['main-menu']
      endif
    %}

    <nav class="menu-drawer__nav" aria-label="{{ 'rifano.menu' | t }}">
      {% if nav_menu.links != blank %}
        <ul class="menu-drawer__list">
          {% for link in nav_menu.links %}
            <li class="menu-drawer__item">
              {% if link.links != blank %}
                <details class="menu-drawer__details">
                  <summary class="menu-drawer__summary">
                    <span class="menu-drawer__label">{{ link.title }}</span>
                    <svg class="icon icon--sm menu-drawer__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                      <path d="M6 9l6 6 6-6" />
                    </svg>
                  </summary>
                  <ul class="menu-drawer__sublist">
                    <li class="menu-drawer__subitem">
                      <a
                        href="{{ link.url }}"
                        class="menu-drawer__sublink"
                        {% if link.current %}
                          aria-current="page"
                        {% endif %}
                      >
                        {{ 'rifano.menu_all' | t }} {{ link.title }}
                      </a>
                    </li>
                    {% for child in link.links %}
                      <li class="menu-drawer__subitem">
                        <a
                          href="{{ child.url }}"
                          class="menu-drawer__sublink"
                          {% if child.current %}
                            aria-current="page"
                          {% endif %}
                        >
                          {{ child.title }}
                        </a>
                      </li>
                    {% endfor %}
                  </ul>
                </details>
              {% else %}
                <a
                  href="{{ link.url }}"
                  class="menu-drawer__link"
                  {% if link.current %}
                    aria-current="page"
                  {% endif %}
                >
                  {{ link.title }}
                </a>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      {% else %}
        <p class="menu-drawer__empty t-muted">{{ 'rifano.menu_empty' | t }}</p>
      {% endif %}
    </nav>

    <div class="menu-drawer__bottom">
      <div class="menu-drawer__socials">
        {% if settings.whatsapp_number != blank %}
          <a class="menu-drawer__social" href="https://wa.me/{{ settings.whatsapp_number }}">
            <svg class="icon icon--sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M21 11.5a8.5 8.5 0 0 1-12.4 7.5L3 21l2-5.4A8.5 8.5 0 1 1 21 11.5z" />
            </svg>
            <span>{{ 'rifano.whatsapp' | t }}</span>
          </a>
        {% endif %}
        {% if settings.instagram_url != blank %}
          <a class="menu-drawer__social" href="{{ settings.instagram_url }}">
            <svg class="icon icon--sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" />
            </svg>
            <span>{{ 'rifano.instagram' | t }}</span>
          </a>
        {% endif %}
        {% if settings.tiktok_url != blank %}
          <a class="menu-drawer__social" href="{{ settings.tiktok_url }}">
            <svg class="icon icon--sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M9 8v8a3 3 0 1 0 3 3V4" />
              <path d="M12 8c.5 2.5 2.5 4 5.5 4" />
            </svg>
            <span>{{ 'rifano.tiktok' | t }}</span>
          </a>
        {% endif %}
        {% if settings.support_email != blank %}
          <a class="menu-drawer__social" href="mailto:{{ settings.support_email }}">
            <svg class="icon icon--sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <path d="M3 7l9 6 9-6" />
            </svg>
            <span>{{ settings.support_email }}</span>
          </a>
        {% endif %}
      </div>
      <p class="menu-drawer__note t-muted">
        {{ 'rifano.cod_delivery' | t }}{% if settings.delivery_text != blank %} · {{ settings.delivery_text }}{% endif %}
      </p>
    </div>
  </div>
</dialog>

<script src="{{ 'menu-drawer.js' | asset_url }}" type="module" defer></script>

{% schema %}
{
  "name": "Menu drawer",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
