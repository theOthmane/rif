{% comment %}
  Default page (spec 11): the page content as rich text. The title belongs to
  the `page-header` section above, so this section renders the content only —
  and nothing at all when the page is empty.
{% endcomment %}

{%- unless template.name == 'page' -%}
  {{ 'pages.css' | asset_url | stylesheet_tag }}
  {{ 'rte.css' | asset_url | stylesheet_tag }}
{%- endunless -%}

{%- if page.content != blank -%}
  <div class="page-content page-width">
    <div class="rte">{{ page.content }}</div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Main page",
  "settings": [],
  "presets": [{ "name": "Main page" }]
}
{% endschema %}
