{% comment %}Persistent COD announcement bar.{% endcomment %}

{%- comment -%}
  The type lives on `.announcement__text` in header.css, not on `.t-label`.
  This is a sentence the store makes on every page, not a field label: sentence
  case at `--fs-sm` reads as a promise, uppercase 12px micro-type reads as a
  template ticker. Words unchanged.
{%- endcomment -%}

<div class="announcement">
  <p class="announcement__text">
    {% if settings.announcement_text != blank %}
      {{ settings.announcement_text }}
    {% else %}
      {{ 'rifano.announcement' | t }}
    {% endif %}
  </p>
</div>

{% schema %}
{
  "name": "Announcement",
  "settings": [],
  "presets": [{ "name": "Announcement" }]
}
{% endschema %}
