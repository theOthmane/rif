{% comment %}
  Password "Bientôt" (spec 12): full-viewport centred column — the lockup, a
  Tenor "Bientôt.", the tagline, the welcome touch, the merchant message, an
  email signup (`customer` form tagged `prospect`), then a small "Accès
  boutique" disclosure holding the password form, and the socials. No header,
  footer or announcement bar (see layout/password.liquid).
{% endcomment %}

{{ 'system.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign wa_number = settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-'
-%}

<div class="password">
  <div class="password__inner">
    <a class="password__brand" href="{{ routes.root_url }}" aria-label="RIFANO — {{ shop.name }}">
      {% render 'logo', variant: 'lockup' %}
    </a>

    <h1 class="password__title t-page-title">{{ 'rifano.password_soon' | t }}</h1>
    <p class="password__tagline t-display">{{ 'rifano.tagline_1' | t }} {{ 'rifano.tagline_2' | t }}</p>
    <p class="password__welcome t-label">{{ 'rifano.welcome' | t }}</p>

    {%- unless shop.password_message == blank -%}
      <p class="password__message">{{ shop.password_message }}</p>
    {%- endunless -%}

    {%- form 'customer', class: 'password__form' -%}
      {%- if form.posted_successfully? -%}
        <p class="password__success" role="status">{{ 'rifano.password_success' | t }}</p>
      {%- else -%}
        {%- if form.errors -%}
          <div class="password__errors" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}

        <input type="hidden" name="contact[tags]" value="prospect">

        <div class="password__field">
          <label class="visually-hidden" for="password-email-{{ section.id }}">{{ 'rifano.password_email_label' | t }}</label>
          <input
            type="email"
            id="password-email-{{ section.id }}"
            name="contact[email]"
            autocomplete="email"
            required="required"
            placeholder="{{ 'rifano.password_email_placeholder' | t }}"
          >
        </div>

        <button type="submit" class="btn btn--block">{{ 'rifano.password_signup' | t }}</button>
      {%- endif -%}
    {%- endform -%}

    <details class="password__access">
      <summary class="password__access-toggle">{{ 'rifano.password_access' | t }}</summary>
      <div class="password__access-body">
        {%- form 'storefront_password', class: 'password__form' -%}
          {%- if form.errors -%}
            <div class="password__errors" role="alert">{{ form.errors | default_errors }}</div>
          {%- endif -%}

          <div class="password__field">
            <label for="password-input-{{ section.id }}">{{ 'rifano.password_label' | t }}</label>
            <input
              type="password"
              id="password-input-{{ section.id }}"
              name="password"
              autocomplete="current-password"
            >
          </div>

          <button type="submit" class="btn btn--ghost btn--block">{{ 'rifano.password_enter' | t }}</button>
        {%- endform -%}
      </div>
    </details>

    {%- if wa_number != blank or settings.support_email != blank or settings.instagram_url != blank or settings.tiktok_url != blank -%}
      <ul class="password__socials">
        {%- if wa_number != blank -%}
          <li>
            <a class="password__social" href="https://wa.me/{{ wa_number }}" aria-label="{{ 'rifano.whatsapp' | t }}">
              {% render 'icon', name: 'whatsapp' %}
            </a>
          </li>
        {%- endif -%}
        {%- if settings.support_email != blank -%}
          <li>
            <a class="password__social" href="mailto:{{ settings.support_email }}" aria-label="{{ 'rifano.email_label' | t }}">
              {% render 'icon', name: 'mail' %}
            </a>
          </li>
        {%- endif -%}
        {%- if settings.instagram_url != blank -%}
          <li>
            <a class="password__social" href="{{ settings.instagram_url }}" target="_blank" rel="noopener" aria-label="{{ 'rifano.instagram' | t }}">
              {% render 'icon', name: 'instagram' %}
            </a>
          </li>
        {%- endif -%}
        {%- if settings.tiktok_url != blank -%}
          <li>
            <a class="password__social" href="{{ settings.tiktok_url }}" target="_blank" rel="noopener" aria-label="{{ 'rifano.tiktok' | t }}">
              {% render 'icon', name: 'tiktok' %}
            </a>
          </li>
        {%- endif -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Main password",
  "settings": [],
  "presets": [{ "name": "Main password" }]
}
{% endschema %}
