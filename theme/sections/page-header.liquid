{% comment %}
  Content-page header (spec 11): the brand eyebrow and the page title, centred,
  with the section rhythm on top. Every content template composes it, so the
  title typography lives in one place and `main-page` keeps only the content.
{% endcomment %}

{{ 'pages.css' | asset_url | stylesheet_tag }}

<div class="page-header page-width">
  <p class="page-header__eyebrow t-label">RIFANO</p>
  <h1 class="page-header__title t-page-title">{{ page.title }}</h1>
</div>

{% schema %}
{
  "name": "Page header",
  "settings": [],
  "presets": [{ "name": "Page header" }]
}
{% endschema %}
