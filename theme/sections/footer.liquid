{% comment %}
  RIFANO footer — one calm band: brand left, nav and contact right, then a
  hairline and the legal bar. The COD + free-delivery promise is deliberately
  not repeated here: the announcement bar already carries it, and the old
  promise strip made it the third repeat on the same screen.
{% endcomment %}

{%- liquid
  assign shop_links = section.settings.menu_shop.links
  assign help_links = section.settings.menu_help.links
  assign footer_nav = ''
  assign seen_urls = ''
-%}
{%- comment -%}
  One list, shop links then help links, deduped by URL. Capturing each item and
  appending keeps a single <ul> even though the links come from two menus.
{%- endcomment -%}
{%- for link in shop_links -%}
  {%- assign link_key = link.url | append: '||' -%}
  {%- unless seen_urls contains link_key -%}
    {%- assign seen_urls = seen_urls | append: link_key -%}
    {%- capture footer_nav_item -%}
      <li class="footer__nav-item">
        <a
          class="footer__nav-link"
          href="{{ link.url }}"
          {% if link.current %} aria-current="page" {% endif %}
        >{{ link.title }}</a>
      </li>
    {%- endcapture -%}
    {%- assign footer_nav = footer_nav | append: footer_nav_item -%}
  {%- endunless -%}
{%- endfor -%}
{%- for link in help_links -%}
  {%- assign link_key = link.url | append: '||' -%}
  {%- unless seen_urls contains link_key -%}
    {%- assign seen_urls = seen_urls | append: link_key -%}
    {%- capture footer_nav_item -%}
      <li class="footer__nav-item">
        <a
          class="footer__nav-link"
          href="{{ link.url }}"
          {% if link.current %} aria-current="page" {% endif %}
        >{{ link.title }}</a>
      </li>
    {%- endcapture -%}
    {%- assign footer_nav = footer_nav | append: footer_nav_item -%}
  {%- endunless -%}
{%- endfor -%}

{%- liquid
  assign has_contact = false
  if settings.whatsapp_number != blank or settings.support_email != blank or settings.instagram_url != blank or settings.tiktok_url != blank
    assign has_contact = true
  endif
  assign has_footer_right = false
  if footer_nav != blank or has_contact
    assign has_footer_right = true
  endif
-%}

<footer class="site-footer full-width" data-depth-footer>
  <div class="site-footer__inner">
    <div class="footer__top">
      <a class="footer__brand" href="{{ routes.root_url }}" aria-label="RIFANO — {{ shop.name }}">
        {% render 'logo', variant: 'monogram', class: 'footer__monogram' %}
        <span class="logo__wordmark" aria-hidden="true">RIFANO</span>
      </a>

      {%- if has_footer_right -%}
      <div class="footer__right">
        {%- if footer_nav != blank -%}
          <nav class="footer__nav" aria-label="{{ 'rifano.footer_nav' | t }}">
            <ul class="footer__nav-list">
              {{ footer_nav }}
            </ul>
          </nav>
        {%- endif -%}

        {%- if has_contact -%}
          <ul class="footer__contact">
            {%- if settings.whatsapp_number != blank -%}
              <li class="footer__contact-item">
                <a class="footer__contact-link" href="https://wa.me/{{ settings.whatsapp_number }}">
                  {% render 'icon', name: 'whatsapp' %}
                  <span>{{ 'rifano.whatsapp' | t }}</span>
                </a>
              </li>
            {%- endif -%}
            {%- if settings.support_email != blank -%}
              <li class="footer__contact-item">
                <a class="footer__contact-link" href="mailto:{{ settings.support_email }}">
                  {% render 'icon', name: 'mail' %}
                  <span>{{ settings.support_email }}</span>
                </a>
              </li>
            {%- endif -%}
            {%- if settings.instagram_url != blank -%}
              <li class="footer__contact-item">
                <a class="footer__contact-link" href="{{ settings.instagram_url }}">
                  {% render 'icon', name: 'instagram' %}
                  <span>{{ 'rifano.instagram' | t }}</span>
                </a>
              </li>
            {%- endif -%}
            {%- if settings.tiktok_url != blank -%}
              <li class="footer__contact-item">
                <a class="footer__contact-link" href="{{ settings.tiktok_url }}">
                  {% render 'icon', name: 'tiktok' %}
                  <span>{{ 'rifano.tiktok' | t }}</span>
                </a>
              </li>
            {%- endif -%}
          </ul>
        {%- endif -%}
      </div>
      {%- endif -%}
    </div>

    <div class="footer__legal">
      <p class="footer__copy">&copy; {{ 'now' | date: '%Y' }} RIFANO · {{ 'rifano.tagline_1' | t }} {{ 'rifano.tagline_2' | t }}</p>

      {%- if shop.privacy_policy != blank or shop.refund_policy != blank or shop.shipping_policy != blank or shop.terms_of_service != blank -%}
        <ul class="footer__policies">
          {%- if shop.privacy_policy != blank -%}
            <li>
              <a class="footer__policy-link" href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title }}</a>
            </li>
          {%- endif -%}
          {%- if shop.refund_policy != blank -%}
            <li>
              <a class="footer__policy-link" href="{{ shop.refund_policy.url }}">{{ shop.refund_policy.title }}</a>
            </li>
          {%- endif -%}
          {%- if shop.shipping_policy != blank -%}
            <li>
              <a class="footer__policy-link" href="{{ shop.shipping_policy.url }}">{{ shop.shipping_policy.title }}</a>
            </li>
          {%- endif -%}
          {%- if shop.terms_of_service != blank -%}
            <li>
              <a class="footer__policy-link" href="{{ shop.terms_of_service.url }}">{{ shop.terms_of_service.title }}</a>
            </li>
          {%- endif -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:general.footer",
  "settings": [
    {
      "type": "link_list",
      "id": "menu_shop",
      "label": "t:labels.menu",
      "default": "footer"
    },
    {
      "type": "link_list",
      "id": "menu_help",
      "label": "t:labels.menu"
    }
  ],
  "presets": [{ "name": "Footer" }]
}
{% endschema %}
