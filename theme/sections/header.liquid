{% comment %}RIFANO site header: menu button left, RF monogram centre, cart right. Sticky with a scroll hairline.{% endcomment %}

<header class="site-header">
  <div class="site-header__inner">
    <div class="site-header__left">
      <button
        type="button"
        id="menu-button"
        class="icon-button header__menu-button"
        aria-controls="menu-drawer"
        aria-expanded="false"
      >
        {% render 'icon', name: 'menu' %}
        <span class="visually-hidden">{{ 'rifano.menu' | t }}</span>
      </button>
    </div>

    <div class="site-header__logo">
      <a href="{{ routes.root_url }}" class="header__logo">
        {% render 'logo', variant: 'monogram' %}
      </a>
    </div>

    <div class="site-header__right">
      <a
        href="{{ routes.cart_url }}"
        class="icon-button header__cart"
        {%- if cart.item_count == 0 -%}
          aria-label="{{ 'rifano.cart' | t }}"
        {%- else -%}
          aria-label="{{ 'rifano.cart_with_count' | t: count: cart.item_count }}"
        {%- endif -%}
      >
        {% render 'icon', name: 'cart' %}
        <span id="cart-icon-bubble" class="cart-count" {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [],
  "presets": [{ "name": "Header" }]
}
{% endschema %}
