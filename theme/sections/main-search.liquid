{% comment %}
  Search (spec 12): a big field prefilled with `search.terms`, a results count,
  products as `product-card`s in the collection grid, pages and articles as
  text rows below, paginated at 24. With no query — or no results — the
  home-row collections plus the Boutique stand in as suggestions, so the page
  never renders bare. No predictive search in v1.
{% endcomment %}

{{ 'collection.css' | asset_url | stylesheet_tag }}
{{ 'system.css' | asset_url | stylesheet_tag }}

{%- capture search_suggestions -%}
  <div class="search__suggest">
    <p class="search__suggest-label t-label">{{ 'rifano.search_suggestions' | t }}</p>
    <ul class="search__suggest-list">
      {%- for link in settings.home_rows_menu.links -%}
        {%- if link.type == 'collection_link' and link.object != blank -%}
          <li class="search__suggest-item">
            <a class="btn btn--ghost" href="{{ link.url }}">{{ link.title }}</a>
          </li>
        {%- endif -%}
      {%- endfor -%}
      <li class="search__suggest-item">
        <a class="btn btn--ghost" href="{{ routes.collections_url }}">{{ 'rifano.search_boutique' | t }}</a>
      </li>
    </ul>
  </div>
{%- endcapture -%}

<div class="search page-width">
  <h1 class="search__title t-page-title">{{ 'rifano.search_title' | t }}</h1>

  <form action="{{ routes.search_url }}" method="get" role="search" class="search__form">
    <label class="visually-hidden" for="search-field-{{ section.id }}">{{ 'rifano.search_label' | t }}</label>
    <input
      class="search__input"
      type="search"
      id="search-field-{{ section.id }}"
      name="q"
      value="{{ search.terms | escape }}"
      placeholder="{{ 'rifano.search_placeholder' | t }}"
    >
    <button type="submit" class="btn search__submit">{{ 'rifano.search_label' | t }}</button>
  </form>

  {%- if search.performed -%}
    {%- if search.results_count == 0 -%}
      <p class="search__count" role="status">{{ 'rifano.search_no_results' | t: terms: search.terms }}</p>
      {{ search_suggestions }}
    {%- else -%}
      <p class="search__count" role="status">
        {{- 'rifano.search_count' | t: count: search.results_count, terms: search.terms -}}
      </p>

      {% paginate search.results by 24 %}
        {%- assign has_products = false -%}
        {%- assign has_text = false -%}
        {%- for result in search.results -%}
          {%- if result.object_type == 'product' -%}
            {%- assign has_products = true -%}
          {%- else -%}
            {%- assign has_text = true -%}
          {%- endif -%}
        {%- endfor -%}

        {%- if has_products -%}
          <h2 class="search__subtitle t-label{% unless has_text %} visually-hidden{% endunless %}">{{ 'rifano.search_products' | t }}</h2>

          {%- assign card_index = 0 -%}
          <ul class="collection-grid">
            {%- for result in search.results -%}
              {%- if result.object_type == 'product' -%}
                {%- assign card_index = card_index | plus: 1 -%}
                <li class="collection-grid__item">
                  {%- if card_index <= 4 -%}
                    {% render 'product-card', product: result, loading: 'eager' %}
                  {%- else -%}
                    {% render 'product-card', product: result %}
                  {%- endif -%}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if has_text -%}
          {%- if has_products -%}
            <h2 class="search__subtitle t-label">{{ 'rifano.search_pages' | t }}</h2>
          {%- endif -%}

          <ul class="search__rows">
            {%- for result in search.results -%}
              {%- unless result.object_type == 'product' -%}
                <li class="search__row">
                  <a class="search__row-link" href="{{ result.url }}">
                    <span class="search__row-title">{{ result.title }}</span>
                    {% render 'icon', name: 'arrow-right', class: 'search__row-icon' %}
                  </a>
                </li>
              {%- endunless -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {% render 'pagination', paginate: paginate %}
      {% endpaginate %}
    {%- endif -%}
  {%- else -%}
    <p class="search__count t-muted">{{ 'rifano.search_empty_hint' | t }}</p>
    {{ search_suggestions }}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Main search",
  "settings": [],
  "presets": [{ "name": "Main search" }]
}
{% endschema %}
