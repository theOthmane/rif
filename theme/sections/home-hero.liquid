{% comment %}
  RIFANO home intro: "Be different / Be RIFANO" over the watch stage.
  Poster version by default; spec 14 mounts the canvas scrub inside
  .hero__stage when hero-scrub.js adds .is-scrub, so the class names below
  are its contract and must not be renamed. This section is
  the home page's only <h1>.
{% endcomment %}

{{ 'home-hero.css' | asset_url | stylesheet_tag }}

{% liquid
  assign hero_poster = settings.hero_poster
  if hero_poster.alt == blank
    assign poster_alt = 'rifano.hero_poster_alt' | t
  else
    assign poster_alt = hero_poster.alt
  endif
  assign scrub_enabled = settings.hero_scrub_enabled
  if scrub_enabled == nil
    assign scrub_enabled = true
  endif
  assign frames_desktop = settings.hero_frames_desktop | default: 96
  assign frames_mobile = settings.hero_frames_mobile | default: 72
%}

<hero-scrub>
<section class="hero" data-hero data-scrub="{{ scrub_enabled }}">
  <div class="hero__sticky">
    <h1 class="hero__title t-display">
      <span class="hero__line">{{ 'rifano.tagline_1' | t }}</span>
      <span class="hero__line hero__line--accent">{{ 'rifano.tagline_2' | t }}</span>
    </h1>

    <div class="hero__stage">
      {% if hero_poster != blank %}
        <img
          class="hero__poster"
          src="{{ hero_poster | image_url: width: 1600 }}"
          srcset="{{ hero_poster | image_url: width: 800 }} 800w, {{ hero_poster | image_url: width: 1200 }} 1200w, {{ hero_poster | image_url: width: 1600 }} 1600w"
          sizes="(min-width: 768px) 60vw, 100vw"
          width="{{ hero_poster.width }}"
          height="{{ hero_poster.height }}"
          alt="{{ poster_alt | escape }}"
          fetchpriority="high"
          loading="eager"
        >
      {% else %}
        {% comment %}
          Spec 14 deviation (PM decision 1): no merchant poster is set, so the
          front view frame doubles as the poster/LCP image instead of the
          placeholder ring. 1280x720 measured on disk (spec 13).
        {% endcomment %}
        <img
          class="hero__poster"
          src="{{ 'hero-d-096.webp' | asset_url }}"
          width="1280"
          height="720"
          alt="{{ poster_alt | escape }}"
          fetchpriority="high"
          loading="eager"
        >
      {% endif %}
      <canvas class="hero__canvas" aria-hidden="true"></canvas>
      <div class="hero__floor" aria-hidden="true"></div>
    </div>

    <p class="hero__cta">
      <a class="btn" href="{{ routes.collections_url }}">{{ 'rifano.hero_cta' | t }}</a>
    </p>
  </div>
</section>

{% if scrub_enabled %}
  {%- capture urls_d -%}
    {%- for i in (1..frames_desktop) -%}
      {%- assign n = '00' | append: i | slice: -3, 3 -%}
      "{{- 'hero-d-' | append: n | append: '.webp' | asset_url -}}"
      {%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- capture urls_m -%}
    {%- for i in (1..frames_mobile) -%}
      {%- assign n = '00' | append: i | slice: -3, 3 -%}
      "{{- 'hero-m-' | append: n | append: '.webp' | asset_url -}}"
      {%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  {%- endcapture -%}
  <script type="application/json" data-frames>
    {"desktop":[{{ urls_d }}],"mobile":[{{ urls_m }}]}
  </script>
{% endif %}
</hero-scrub>

<script src="{{ 'home-hero.js' | asset_url }}" type="module" defer></script>
{% if scrub_enabled %}
  <script src="{{ 'hero-scrub.js' | asset_url }}" type="module" defer></script>
{% endif %}

{% schema %}
{
  "name": "Home hero",
  "settings": [],
  "presets": [{ "name": "Home hero" }]
}
{% endschema %}
