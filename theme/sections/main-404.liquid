{% comment %}
  404 (spec 12): one centred column — the monogram at 64px, a display title,
  one line, and two theme buttons. No browser-default blue anywhere.
{% endcomment %}

{{ 'system.css' | asset_url | stylesheet_tag }}

<div class="not-found page-width">
  <div class="not-found__mark" aria-hidden="true">
    {% render 'logo', variant: 'monogram' %}
  </div>
  <h1 class="not-found__title t-page-title">{{ 'rifano.not_found_title' | t }}</h1>
  <p class="not-found__text">{{ 'rifano.not_found_text' | t }}</p>
  <div class="not-found__actions">
    <a class="btn" href="{{ routes.root_url }}">{{ 'rifano.not_found_home' | t }}</a>
    <a class="btn btn--ghost" href="{{ routes.collections_url }}">{{ 'rifano.not_found_boutique' | t }}</a>
  </div>
</div>

{% schema %}
{
  "name": "Main 404",
  "settings": [],
  "presets": [{ "name": "Main 404" }]
}
{% endschema %}
